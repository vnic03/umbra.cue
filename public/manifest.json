{
  "manifest_version": 3,
  "name": "umbra.cue",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "description": "Your watch progress on RamoFlix, saved locally in Brave.",
  "minimum_chrome_version": "110",
  "permissions": ["storage"],
  "host_permissions": ["https://ramoflix.net/*", "https://www.ramoflix.net/*", "https://image.tmdb.org/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "umbra.cue · Watchlist",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://ramoflix.net/*", "https://www.ramoflix.net/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
